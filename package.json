{
  "name": "phishtest-outlook-addin",
  "version": "1.0.0",
  "description": "Outlook add-in that checks for the X-PHISHTEST header and displays a warning notification",
  "scripts": {
    "start": "pnpm exec http-server . -p 3000 -c-1 -S -C certs/cert.pem -K certs/key.pem --cors",
    "start-http": "pnpm exec http-server . -p 3000 -c-1 --cors",
    "manifest:prod": "node scripts/make-prod-manifest.js",
    "validate": "pnpm exec office-addin-manifest validate",
    "test": "node test/parser.test.js"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "office-addin-manifest": "^2.1.6"
  },
  "keywords": [
    "outlook",
    "add-in",
    "office-js",
    "phishing",
    "headers"
  ],
  "license": "MIT"
}
